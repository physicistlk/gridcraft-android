+//! Modifier keys, tracked by the shell because the platform never reports them.
+//!
+//! # The gap
+//!
+//! winit 0.30.13's Android backend emits exactly six window events — `Focused`, `Resized`,
+//! `ScaleFactorChanged`, `RedrawRequested`, `Touch` and `KeyboardInput`
+//! (`src/platform_impl/android/mod.rs`) — and **never** `WindowEvent::ModifiersChanged`. egui-winit
+//! updates its modifier state from that one event and nowhere else, and egui 0.36 carries
+//! modifiers as an *event* (`RawInput` has no `modifiers` field any more), so on Android
+//! `ctx.input(|i| i.modifiers)` is the all-false default for the whole run:
+//!
+//! - Shift+click selects a single cell instead of extending the selection,
+//! - Ctrl+C / Ctrl+V / Ctrl+S and every other modifier shortcut does nothing,
+//! - Alt keytips never come up.
+//!
+//! The *key events themselves* do arrive, so the modifiers can be tracked from them — which is what
+//! a desktop backend does internally. This module does that and reports the state the way egui
+//! expects: `Event::ModifiersChanged` (egui's `InputState` reads modifiers from that event alone)
+//! plus the per-event `modifiers` copies that `Event::Key` and `Event::PointerButton` carry.
+//!
+//! Call [`Tracked::apply`] from the shell's `eframe::App::raw_input_hook`, *before* forwarding to
+//! the app's own hook, so the app sees the same frames it would on the desktop.
+//!
+//! # What it does not do
+//!
+//! The Super/Windows key is deliberately not tracked: on Windows and Linux egui's `command`
+//! modifier is Ctrl and `mac_cmd` is documented as macOS-only, so there is no modifier here for it
+//! to become. Alt is tracked and reported — it is what opens keytips — but egui's own note that
+//! Alt+Shift is how macOS types special characters does not apply on Android.
+
+/// The three modifiers that mean something on this platform, held between frames.
+///
+/// Between frames because the key press and the click are usually in *different* frames: the user
+/// holds Shift down, and only then taps a cell.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Tracked {
+    alt: bool,
+    ctrl: bool,
+    shift: bool,
+}
+
+/// A modifier a key event is about.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Modifier {
+    Alt,
+    Ctrl,
+    Shift,
+}
+
+/// Which modifier a key event is *about*, from its logical or its physical key.
+///
+/// Both have to be consulted, and on Android it is the physical one that matters: winit's
+/// logical-key table names `Shift` and `Alt` but **not** `Control` (see
+/// `platform_impl/android/keycodes.rs::to_logical`), so a Ctrl press arrives with an unidentified
+/// logical key and only its `physical_key` — which maps `CtrlLeft`/`CtrlRight` to
+/// `ControlLeft`/`ControlRight` — says what it was. That asymmetry is precisely what a user sees:
+/// Shift+click and Shift+arrow work, Ctrl+anything does nothing.
+fn modifier(key: &egui::Key, physical_key: &Option<egui::Key>) -> Option<Modifier> {
+    for k in std::iter::once(key).chain(physical_key.iter()) {
+        match k {
+            egui::Key::ShiftLeft | egui::Key::ShiftRight => return Some(Modifier::Shift),
+            egui::Key::ControlLeft | egui::Key::ControlRight => return Some(Modifier::Ctrl),
+            egui::Key::AltLeft | egui::Key::AltRight => return Some(Modifier::Alt),
+            _ => {}
+        }
+    }
+    None
+}
+
+impl Tracked {
+    /// Fold this frame's events into the tracked state and report it back into them.
+    ///
+    /// Returns the state as `egui::Modifiers`, for the caller that needs to put it on an event of
+    /// its own — the shell's touch-to-wheel bridge does (Ctrl+wheel zooms).
+    pub fn apply(&mut self, raw: &mut egui::RawInput) -> egui::Modifiers {
+        let events = std::mem::take(&mut raw.events);
+        let mut out = Vec::with_capacity(events.len() + 1);
+        for mut event in events {
+            self.observe(&event);
+            // Every event that carries a copy gets the state as it stands at that point in the
+            // batch, so a Shift press and a click in the same frame are ordered correctly.
+            let modifiers = self.reported();
+            match &mut event {
+                egui::Event::Key { modifiers: m, .. } | egui::Event::PointerButton { modifiers: m, .. } => *m = modifiers,
+                _ => {}
+            }
+            out.push(event);
+        }
+        // egui's `InputState` takes modifiers from this event and nowhere else, and a frame with no
+        // key events in it — the vast majority — still has to report the state it is holding.
+        let reported = self.reported();
+        out.push(egui::Event::ModifiersChanged(reported));
+        raw.events = out;
+        reported
+    }
+
+    /// The state as egui wants to see it.
+    fn reported(&self) -> egui::Modifiers {
+        // On Windows and Linux the shortcut modifier is Ctrl, and `mac_cmd` must stay off there.
+        egui::Modifiers { alt: self.alt, ctrl: self.ctrl, shift: self.shift, mac_cmd: false, command: self.ctrl }
+    }
+
+    /// Update from one event.
+    fn observe(&mut self, event: &egui::Event) {
+        match event {
+            // A modifier key going down or coming up.
+            egui::Event::Key { key, physical_key, pressed, .. } => match modifier(key, physical_key) {
+                Some(Modifier::Shift) => self.shift = *pressed,
+                Some(Modifier::Ctrl) => self.ctrl = *pressed,
+                Some(Modifier::Alt) => self.alt = *pressed,
+                None => {}
+            },
+            // The platform reported them itself. It never does on Android, but egui-winit
+            // synthesises one when the window loses focus, and that report is authoritative: it is
+            // how a modifier that was held while the app went to the background stops being stuck.
+            egui::Event::ModifiersChanged(reported) => {
+                self.shift = reported.shift;
+                self.ctrl = reported.ctrl;
+                self.alt = reported.alt;
+            }
+            _ => {}
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use egui::{Event, Key, Modifiers};
+
+    fn key(k: Key, physical: Option<Key>, pressed: bool) -> Event {
+        Event::Key { key: k, physical_key: physical, pressed, repeat: false, modifiers: Modifiers::default() }
+    }
+
+    fn run(t: &mut Tracked, events: Vec<Event>) -> egui::RawInput {
+        let mut raw = egui::RawInput { events, ..Default::default() };
+        t.apply(&mut raw);
+        raw
+    }
+
+    /// What the frame reports: egui reads modifiers from `ModifiersChanged` and nowhere else, so every
+    /// frame must end with one.
+    fn reported(raw: &egui::RawInput) -> Modifiers {
+        match raw.events.last() {
+            Some(Event::ModifiersChanged(m)) => *m,
+            other => panic!("a frame must end with ModifiersChanged: {other:?}"),
+        }
+    }
+
+    /// The bug this module exists for, in the form Android reports it: winit's logical-key table does
+    /// not name the Control keys, so when the physical key is the only one that identifies them the
+    /// event must still be understood. Tracking only the logical key is what left every Ctrl shortcut
+    /// dead while Shift worked.
+    #[test]
+    fn ctrl_is_understood_from_either_the_logical_or_the_physical_key() {
+        assert_eq!(modifier(&Key::ControlLeft, &None), Some(Modifier::Ctrl));
+        assert_eq!(modifier(&Key::ControlRight, &None), Some(Modifier::Ctrl));
+        // The case that matters: the *logical* key says nothing useful (here: an ordinary A) and the
+        // physical key is what identifies the modifier.
+        assert_eq!(modifier(&Key::A, &Some(Key::ControlLeft)), Some(Modifier::Ctrl));
+        assert_eq!(modifier(&Key::ShiftLeft, &None), Some(Modifier::Shift));
+        assert_eq!(modifier(&Key::A, &Some(Key::A)), None, "an ordinary key is not a modifier");
+    }
+
+    /// Tracked and released through `apply`, and the state persists across frames with no events
+    /// (which is most frames — the key press and the shortcut it enables are usually in different ones).
+    #[test]
+    fn a_held_modifier_is_reported_in_frames_with_no_events() {
+        let mut t = Tracked::default();
+        let m = reported(&run(&mut t, vec![key(Key::ControlLeft, Some(Key::ControlLeft), true)]));
+        assert!(m.ctrl && m.command, "Ctrl is egui's command modifier: {m:?}");
+        assert!(!m.mac_cmd && !m.shift && !m.alt);
+        let quiet = run(&mut t, vec![]);
+        assert!(reported(&quiet).ctrl, "a frame with no events still reports what is held");
+        assert_eq!(quiet.events.len(), 1, "and its only event is that report");
+        let released = reported(&run(&mut t, vec![key(Key::ControlLeft, Some(Key::ControlLeft), false)]));
+        assert!(!released.ctrl, "released");
+    }
+
+    /// Order inside one batch: a press applies to the events after it, not before it.
+    #[test]
+    fn the_state_is_the_one_at_that_point_in_the_batch() {
+        let click = |pressed: bool| Event::PointerButton {
+            pos: egui::pos2(10.0, 10.0),
+            button: egui::PointerButton::Primary,
+            pressed,
+            modifiers: Modifiers::default(),
+        };
+        let mut t = Tracked::default();
+        let mut raw = egui::RawInput {
+            events: vec![click(true), key(Key::ShiftLeft, None, true), click(true)],
+            ..Default::default()
+        };
+        t.apply(&mut raw);
+        let carried = |e: &Event| match e {
+            Event::PointerButton { modifiers, .. } => *modifiers,
+            other => panic!("no modifiers on {other:?}"),
+        };
+        assert!(!carried(&raw.events[0]).shift, "the first click came before the press");
+        assert!(carried(&raw.events[2]).shift, "the second came after it");
+    }
+}
diff --git a/apps/gridcraft-android/src/prefs_watch.rs b/apps/gridcraft-android/src/prefs_watch.rs
new file mode 100644
index 00000000..e8bf1eeb
--- /dev/null
+++ b/apps/gridcraft-android/src/prefs_watch.rs
@@ -0,0 +1,141 @@
+//! Writing the preferences while the app runs, not only on the way out.
+//!
+//! # Why this exists
+//!
+//! The desktop shells write their `ui.json` (and `prefs.json`) from `eframe::App::on_exit`, which
+//! eframe calls when the event loop ends. **Android never gives that ending.** An app is swiped
+//! away from Recents and the process is killed where it stands; a low-memory kill looks the same;
+//! and winit's Android backend does not even forward the activity's `onDestroy` (its
+//! `src/platform_impl/android/mod.rs` logs `TODO: forward onDestroy notification to application`
+//! and carries on). So everything the app keeps between runs died with it: the recent-documents
+//! list, the theme, the interface size, the language, the ribbon state — which a user sees as
+//! "it forgot the file I just saved".
+//!
+//! So the preferences are written as the app runs: when the serialised state *differs* from what
+//! was last written, and at most every [`Self::every`]. Comparing first means an idle app writes
+//! nothing at all, and a change is on disk within the interval.
+//!
+//! # Why the write is atomic
+//!
+//! A second window of the same app (see the shell's new-window path — a second `android_main` in
+//! the same process) writes *the same file*. A plain `fs::write` from two threads can interleave
+//! into a half-written `ui.json`, and a half-written preferences file is every preference lost at
+//! once. So each write goes to its own temporary name and is renamed into place, which is atomic
+//! on the same filesystem: a reader sees either the old file or the new one.
+//!
+//! The same file means the same *content* rules as the desktop, which also has many windows
+//! sharing one `ui.json`: the last writer wins. Nothing is corrupted, but two windows do not merge
+//! their recent lists.
+
+use std::io::Write as _;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::time::{Duration, Instant};
+
+/// The preferences file, how often to look at it, and what was written last.
+pub struct Writer {
+    path: Option<PathBuf>,
+    every: Duration,
+    due_at: Instant,
+    last: Vec<u8>,
+}
+
+impl Writer {
+    /// `every` is how often the state is looked at; a quick look costs a comparison, and a change
+    /// is written as soon as one is due.
+    pub fn new(path: Option<PathBuf>, every: Duration) -> Self {
+        Writer { path, every, due_at: Instant::now() + every, last: Vec::new() }
+    }
+
+    /// Whether it is time to look, and there is somewhere to write.
+    pub fn due(&mut self) -> bool {
+        if self.path.is_none() {
+            return false;
+        }
+        let now = Instant::now();
+        if now < self.due_at {
+            return false;
+        }
+        self.due_at = now + self.every;
+        true
+    }
+
+    /// Write `bytes` if they are not what was last written. Called with what [`Self::due`] asked
+    /// for, or with anything else at any time.
+    pub fn store(&mut self, bytes: &[u8]) {
+        if bytes.is_empty() || bytes == self.last {
+            return;
+        }
+        let Some(path) = self.path.as_ref() else {
+            return;
+        };
+        match write_atomic(path, bytes) {
+            Ok(()) => self.last = bytes.to_vec(),
+            Err(e) => log::warn!("couldn't write the preferences: {e}"),
+        }
+    }
+
+    /// Write now, whatever was written last — for the paths that are not coming back: a quit, and
+    /// `on_exit` if the host ever calls it.
+    pub fn store_now(&mut self, bytes: &[u8]) {
+        self.last.clear();
+        self.store(bytes);
+    }
+}
+
+/// How many windows of this app are running in this process.
+///
+/// Not every shell has a quit path to ask (`GridCraft` ends its process directly), so this is
+/// allowed to go uncalled there rather than being cfg'd per app.
+///
+/// A second window is a second `android_main` on its own thread (a second Activity), so this
+/// counts loops rather than apps: the shell registers one at the start and drops it when its loop
+/// ends. It is what tells a window whether ending it should end the *process* (the last window) or
+/// just itself.
+static WINDOWS: AtomicUsize = AtomicUsize::new(0);
+
+/// The number of windows this process has running, including the calling one.
+///
+/// Not every shell has a quit path to ask (`GridCraft` ends its process directly), so this is
+/// allowed to go uncalled there.
+#[allow(dead_code)]
+pub fn windows() -> usize {
+    WINDOWS.load(Ordering::Relaxed)
+}
+
+/// Count a window: the returned guard *is* the registration, and dropping it (when `android_main`
+/// returns) uncounts it.
+pub fn counted_window() -> Window {
+    WINDOWS.fetch_add(1, Ordering::Relaxed);
+    Window
+}
+
+/// One running window; see [`counted_window`].
+pub struct Window;
+
+impl Drop for Window {
+    fn drop(&mut self) {
+        WINDOWS.fetch_sub(1, Ordering::Relaxed);
+    }
+}
+
+/// Write `bytes` to `path` through a temporary file of its own, then rename it into place.
+///
+/// The unique name is the process id plus a counter: two windows are two threads of one process,
+/// so a name based on either alone would collide.
+fn write_atomic(path: &Path, bytes: &[u8]) -> std::io::Result<()> {
+    static N: AtomicUsize = AtomicUsize::new(0);
+    let name = path.file_name().map(|n| n.to_string_lossy().into_owned()).unwrap_or_else(|| "prefs".into());
+    let tmp = path.with_file_name(format!(".{name}.{}-{}.tmp", std::process::id(), N.fetch_add(1, Ordering::Relaxed)));
+    let mut file = std::fs::File::create(&tmp)?;
+    file.write_all(bytes)?;
+    file.sync_all().ok();
+    drop(file);
+    match std::fs::rename(&tmp, path) {
+        Ok(()) => Ok(()),
+        Err(e) => {
+            let _ = std::fs::remove_file(&tmp);
+            Err(e)
+        }
+    }
+}
diff --git a/apps/gridcraft-android/src/touch_scroll.rs b/apps/gridcraft-android/src/touch_scroll.rs
new file mode 100644
index 00000000..8fc3b8ab
--- /dev/null
+++ b/apps/gridcraft-android/src/touch_scroll.rs
@@ -0,0 +1,233 @@
+//! Two-finger scrolling for the shell: the platform sends touches, the apps want a wheel.
+//!
+//! # The gap
+//!
+//! Every app in this suite scrolls from `egui::Event::MouseWheel`. WordCraft's `scroll.rs` is
+//! explicit about what it expects — pixel deltas move the page 1:1, `TouchPhase::End` on the last
+//! event is the "fingers lifted" signal that starts the kinetic coast — and it is written for a
+//! *touch* device: it handles phases, synthesises momentum where the platform does not, and takes
+//! wheel notches as three lines. None of that ever runs on Android, because winit's Android backend
+//! has no mouse and therefore emits no wheel events at all (`src/platform_impl/android/mod.rs` sends
+//! six window events and a wheel is not one of them). Touch arrives as `WindowEvent::Touch`, which
+//! egui-winit forwards as `egui::Event::Touch` *and* turns into an emulated mouse pointer — so a
+//! finger drags a selection, and the page never moves. Exactly the complaint a tablet user makes.
+//!
+//! # What this does
+//!
+//! Turns a **two-finger drag** into wheel events and leaves one finger alone:
+//!
+//! - one finger: untouched, so dragging still selects text — the emulated pointer works as before;
+//! - two or more fingers: the centroid's movement becomes `Event::MouseWheel` with
+//!   `MouseWheelUnit::Point` and `TouchPhase::Move`, and a final `TouchPhase::End` event when the
+//!   fingers lift, which is what makes the apps coast to a stop;
+//! - while a two-finger gesture is live the emulated **pointer button** events are dropped, or the
+//!   first finger would drag a selection across the page at the same time as it scrolled. The
+//!   pointer *position* events are kept: the apps only scroll while the pointer is over the canvas.
+//!
+//! The touch events themselves are left in the batch — egui's pinch handling (`zoom_delta`) reads
+//! them and the apps zoom with it, so a pinch keeps working and a two-finger *pan* moves nothing but
+//! the page.
+//!
+//! Two fingers is the convention a tablet user already knows from every document viewer, and it
+//! needs nothing from inside the apps: as far as their scroll code is concerned, a touchpad moved.
+//!
+//! Call [`TouchScroll::apply`] from the shell's `eframe::App::raw_input_hook`, after the modifier
+//! tracking, whose reported state the wheel event has to carry (Ctrl+wheel zooms).
+
+use std::collections::HashMap;
+
+/// Touch state between frames: where each finger is (a scroll is a *change* of position and a batch
+/// only carries the new one), and how far the last scroll was measured from.
+#[derive(Debug, Default)]
+pub struct TouchScroll {
+    /// Keyed by the raw id: `egui::TouchId` is a `u64` newtype with no `Hash`,
+    /// so it cannot be a map key itself.
+    fingers: HashMap<u64, egui::Pos2>,
+    /// The centroid the last scroll was measured from. `None` outside a gesture, so the moment a
+    /// second finger lands — which moves the centroid by half the gap between the fingers — is not
+    /// itself a scroll.
+    last: Option<egui::Pos2>,
+    /// A two-finger gesture has scrolled and has not ended: the apps are coasting on the last
+    /// `TouchPhase::End` and must be told when this one finishes.
+    scrolling: bool,
+}
+
+impl TouchScroll {
+    /// Rewrite one frame's events so the apps can scroll from them.
+    ///
+    /// `modifiers` is the shell's tracked state, because egui reads the zoom modifier from the event
+    /// itself (and the platform never reports modifiers — see `modifiers.rs`).
+    pub fn apply(&mut self, raw: &mut egui::RawInput, modifiers: egui::Modifiers) {
+        let events = std::mem::take(&mut raw.events);
+
+        // First the finger bookkeeping, over the whole batch: the events of one frame arrive in
+        // order, and the delta wanted is between this frame's centroid and the last one.
+        for event in &events {
+            if let egui::Event::Touch { id, phase, pos, .. } = event {
+                match phase {
+                    egui::TouchPhase::Start | egui::TouchPhase::Move => {
+                        self.fingers.insert(id.0, *pos);
+                    }
+                    egui::TouchPhase::End | egui::TouchPhase::Cancel => {
+                        self.fingers.remove(&id.0);
+                    }
+                }
+            }
+        }
+
+        let centroid = self.centroid();
+        let gesture = self.fingers.len() >= 2;
+        // Positive is "the content moves down/right", which is what egui documents and what a finger
+        // dragged down the screen means.
+        let delta = match (gesture, centroid, self.last) {
+            (true, Some(now), Some(prev)) => now - prev,
+            _ => egui::Vec2::ZERO,
+        };
+
+        let mut out = Vec::with_capacity(events.len() + 1);
+        for event in events {
+            if gesture && matches!(event, egui::Event::PointerButton { .. }) {
+                continue;
+            }
+            out.push(event);
+        }
+
+        if gesture && delta != egui::Vec2::ZERO {
+            self.scrolling = true;
+            out.push(egui::Event::MouseWheel {
+                unit: egui::MouseWheelUnit::Point,
+                delta,
+                phase: egui::TouchPhase::Move,
+                modifiers,
+                source: egui::MouseWheelSource::Unknown,
+            });
+        } else if self.scrolling && !gesture {
+            // The fingers lifted. The apps' momentum code coasts from this, and a flick that was
+            // fast enough keeps the page moving after the hand is off it.
+            self.scrolling = false;
+            out.push(egui::Event::MouseWheel {
+                unit: egui::MouseWheelUnit::Point,
+                delta: egui::Vec2::ZERO,
+                phase: egui::TouchPhase::End,
+                modifiers,
+                source: egui::MouseWheelSource::Unknown,
+            });
+        }
+
+        self.last = if gesture { centroid } else { None };
+        raw.events = out;
+    }
+
+    /// Where the fingers are, on average. `None` with none down.
+    fn centroid(&self) -> Option<egui::Pos2> {
+        let n = self.fingers.len();
+        if n == 0 {
+            return None;
+        }
+        let sum = self.fingers.values().fold(egui::Vec2::ZERO, |a, p| a + p.to_vec2());
+        Some((sum / n as f32).to_pos2())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn touch(id: u64, phase: egui::TouchPhase, x: f32, y: f32) -> egui::Event {
+        egui::Event::Touch {
+            device_id: egui::TouchDeviceId(0),
+            id: egui::TouchId::from(id),
+            phase,
+            pos: egui::pos2(x, y),
+            force: None,
+        }
+    }
+
+    fn moved(x: f32, y: f32) -> egui::Event {
+        egui::Event::PointerMoved(egui::pos2(x, y))
+    }
+
+    fn press(x: f32, y: f32) -> egui::Event {
+        egui::Event::PointerButton { pos: egui::pos2(x, y), button: egui::PointerButton::Primary, pressed: true, modifiers: Default::default() }
+    }
+
+    fn wheels(raw: &egui::RawInput) -> Vec<(egui::Vec2, egui::TouchPhase)> {
+        raw.events
+            .iter()
+            .filter_map(|e| match e {
+                egui::Event::MouseWheel { delta, phase, .. } => Some((*delta, *phase)),
+                _ => None,
+            })
+            .collect()
+    }
+
+    fn batch(events: Vec<egui::Event>) -> egui::RawInput {
+        egui::RawInput { events, ..Default::default() }
+    }
+
+    #[test]
+    fn one_finger_still_selects_and_never_scrolls() {
+        let mut s = TouchScroll::default();
+        let mut raw = batch(vec![touch(1, egui::TouchPhase::Start, 100.0, 100.0), moved(100.0, 100.0), press(100.0, 100.0)]);
+        s.apply(&mut raw, Default::default());
+        assert!(
+            raw.events.iter().any(|e| matches!(e, egui::Event::PointerButton { pressed: true, .. })),
+            "one finger keeps its press: that is how a tablet drags a selection"
+        );
+        let mut raw = batch(vec![touch(1, egui::TouchPhase::Move, 140.0, 220.0), moved(140.0, 220.0)]);
+        s.apply(&mut raw, Default::default());
+        assert!(wheels(&raw).is_empty(), "one finger does not scroll");
+        assert!(raw.events.iter().any(|e| matches!(e, egui::Event::PointerMoved(_))), "and the drag reaches the app as a pointer drag");
+    }
+
+    #[test]
+    fn two_fingers_scroll_and_the_press_is_dropped() {
+        let mut s = TouchScroll::default();
+        // Finger one lands (the emulated press is what selects on a tablet).
+        let mut raw = batch(vec![touch(1, egui::TouchPhase::Start, 100.0, 100.0), press(100.0, 100.0)]);
+        s.apply(&mut raw, Default::default());
+        // Finger two lands: no scroll yet — the centroid jumped, but nothing has moved.
+        let mut raw = batch(vec![touch(2, egui::TouchPhase::Start, 200.0, 100.0)]);
+        s.apply(&mut raw, Default::default());
+        assert!(wheels(&raw).is_empty(), "a second finger landing is not a scroll");
+        // Both drag down 30 points: the page moves down 30, and no press comes with it.
+        let mut raw = batch(vec![
+            touch(1, egui::TouchPhase::Move, 100.0, 130.0),
+            touch(2, egui::TouchPhase::Move, 200.0, 130.0),
+            moved(100.0, 130.0),
+            press(100.0, 130.0),
+        ]);
+        s.apply(&mut raw, Default::default());
+        let w = wheels(&raw);
+        assert_eq!(w.len(), 1, "one wheel event per frame");
+        assert!((w[0].0.y - 30.0).abs() < 1e-3, "the content follows the fingers: {:?}", w[0].0);
+        assert_eq!(w[0].1, egui::TouchPhase::Move);
+        assert!(!raw.events.iter().any(|e| matches!(e, egui::Event::PointerButton { .. })), "no selection drag while scrolling");
+        assert!(raw.events.iter().any(|e| matches!(e, egui::Event::PointerMoved(_))), "the pointer position stays: the apps only scroll while the pointer is over the canvas");
+        // Both lift: the release the apps coast from.
+        let mut raw = batch(vec![
+            touch(1, egui::TouchPhase::End, 100.0, 130.0),
+            touch(2, egui::TouchPhase::End, 200.0, 130.0),
+        ]);
+        s.apply(&mut raw, Default::default());
+        let w = wheels(&raw);
+        assert_eq!(w.len(), 1, "the fingers lifting is reported");
+        assert_eq!(w[0].1, egui::TouchPhase::End);
+        assert_eq!(w[0].0, egui::Vec2::ZERO, "a lift carries no distance of its own");
+        // And the next frame is quiet: one release, not one per frame.
+        let mut raw = batch(vec![touch(1, egui::TouchPhase::Start, 100.0, 100.0)]);
+        s.apply(&mut raw, Default::default());
+        assert!(wheels(&raw).is_empty());
+    }
+
+    #[test]
+    fn a_pinch_does_not_scroll_the_page() {
+        let mut s = TouchScroll::default();
+        s.apply(&mut batch(vec![touch(1, egui::TouchPhase::Start, 400.0, 400.0), touch(2, egui::TouchPhase::Start, 500.0, 400.0)]), Default::default());
+        // Fingers move apart around a fixed centre: that is egui's zoom_delta, not a scroll.
+        let mut raw = batch(vec![touch(1, egui::TouchPhase::Move, 300.0, 400.0), touch(2, egui::TouchPhase::Move, 600.0, 400.0)]);
+        s.apply(&mut raw, Default::default());
+        assert!(wheels(&raw).is_empty(), "a pinch zooms, it does not scroll: {:?}", wheels(&raw));
+        assert!(raw.events.iter().any(|e| matches!(e, egui::Event::Touch { .. })), "the touch events stay in the batch, egui reads them for zoom");
+    }
+}
