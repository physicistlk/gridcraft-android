new file mode 100644
index 00000000..4efa548a
--- /dev/null
+++ b/apps/gridcraft-android/src/file_picker.rs
@@ -0,0 +1,480 @@
+//! An in-app file picker for Android, drawn with egui — no Java, no native dialog.
+//!
+//! # Why this exists
+//!
+//! `rfd` has no Android backend (its `backend.rs` compiles no module at all for a
+//! target that is neither Linux/BSD, macOS, Windows nor wasm32), and Android's
+//! own picker — the Storage Access Framework — needs `startActivityForResult`,
+//! which `android-activity` 0.6 does not expose. So a ported desktop app has no
+//! file dialogs at all: Open and Save As are silently treated as cancelled.
+//! This module draws the picker instead.
+//!
+//! # How it plugs in
+//!
+//! Every app in this suite has a host-services seam that is *asynchronous* on
+//! the platforms that can't block the frame — the browser build uses it, and so
+//! does this. [`request`] queues a dialog and returns a [`Receiver`] the app
+//! polls once a frame; [`draw`] answers on it from a later frame. The app's own
+//! follow-up (open the file, save there and carry on) then runs, unchanged.
+//!
+//! Shape per app:
+//!
+//! - `Services::file_dialog(req) -> Receiver<Option<String>>` (WordCraft, this
+//!   crate's `FileDialogRequest`): answer `Some(path)`, or `None` for cancelled.
+//! - `Services::pick_save_async(name) -> Receiver<Option<String>>` (GridCraft,
+//!   DeckCraft): the same, for Save As and the exports. Without it the app is
+//!   handed only finished bytes and never learns where they went.
+//! - `Services::open_async` + `Services::inbox` and `pick_picture_async(inbox)`
+//!   (GridCraft, DeckCraft — the web seam): the shell polls the receiver, reads
+//!   the file and pushes `(name, bytes)` into the inbox.
+//! - `download(name, bytes)` (GridCraft, DeckCraft — the last resort): ask for a
+//!   path, then write the bytes there.
+//! - `rfd::AsyncFileDialog` (PdfCraft): the crate's own `crate::rfd` shim, which
+//!   registers here and hands back a future the picker's answer completes.
+//!
+//! An empty answer means cancelled, which is what each of those seams reads as
+//! "the user backed out". Never drop the sender instead.
+//!
+//! # One dialog per window, not per process
+//!
+//! The dialog in flight is a **thread-local**, not a global. A second window of
+//! the same app is a second `android_main` on a thread of its own (a second
+//! Activity, which android-activity supports), and a global would give the two
+//! windows one shared dialog: the second window's request would cancel the
+//! first's, both would draw it, and the file the user tapped could open in the
+//! other window.
+//!
+//! # Permissions
+//!
+//! Android 10+ forbids reading `/storage/emulated/0/Download` by path. Two
+//! routes exist and this picker works with either, because it probes each root
+//! and only offers the ones it can actually read:
+//!
+//! - **App folder** — `external_data_path()`, the app's own directory. Always
+//!   readable and writable, no permission at all. Files can be pushed there over
+//!   USB.
+//! - **Shared storage** — Download / Pictures / DCIM / Documents. Needs
+//!   "All files access" (`MANAGE_EXTERNAL_STORAGE`, granted by hand in
+//!   Settings ▸ Apps ▸ <App> ▸ Special access) or `READ_MEDIA_IMAGES` for
+//!   reading media. All four are declared in the crate's `Cargo.toml`.
+
+use std::cell::RefCell;
+use std::path::{Path, PathBuf};
+use std::sync::OnceLock;
+use std::sync::mpsc::{Receiver, Sender, channel};
+
+/// The app's external files directory, captured in `android_main`.
+///
+/// `<shared storage>/Android/data/<package>/files` — always readable and
+/// writable with no permission, so it is both the picker's default root and the
+/// place Save falls back to. Shared by every window of the app, which is right:
+/// there is one such folder.
+pub static EXT_DIR: OnceLock<PathBuf> = OnceLock::new();
+
+const SHARED_ROOT: &str = "/storage/emulated/0";
+
+/// Which dialog is open.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Kind {
+    /// One file to open.
+    Open,
+    /// Several files.
+    OpenMany,
+    /// A path to save to.
+    Save,
+    /// A folder.
+    Folder,
+}
+
+/// The dialog being shown: what was asked, and how to answer it.
+struct Pending {
+    kind: Kind,
+    title: String,
+    /// Extensions the listing is filtered to (none: every file).
+    extensions: Option<Vec<String>>,
+    /// Directory being browsed.
+    dir: PathBuf,
+    /// File name for a Save dialog.
+    name: String,
+    /// Chosen files, for a multi-select dialog.
+    picked: Vec<PathBuf>,
+    /// A message to show inside the picker (usually a permission problem).
+    note: Option<String>,
+    /// Whether the starting directory was already applied.
+    started: bool,
+    /// Where the answer goes; the app polls it once a frame.
+    answer: Option<Sender<Vec<PathBuf>>>,
+}
+
+thread_local! {
+    /// The dialog *this* window is showing. One per thread; see the module docs.
+    static PENDING: RefCell<Option<Pending>> = const { RefCell::new(None) };
+}
+
+/// Every extension a filter list offers, or `None` when it offers none (then
+/// every file is listed). Convenience for the call sites that build filters.
+///
+/// Not every app reaches every entry point in this file; it is one file shared by four shells, so
+/// an unused one is expected rather than a mistake to delete.
+#[allow(dead_code)]
+pub fn extensions(filters: &[&[&str]]) -> Option<Vec<String>> {
+    let exts: Vec<String> = filters.iter().flat_map(|e| e.iter().map(|s| (*s).to_string())).collect();
+    (!exts.is_empty()).then_some(exts)
+}
+
+/// Queue a dialog and return the receiver its answer arrives on.
+///
+/// A dialog already open in *this* window is answered "cancelled" first; the app
+/// can only use one answer at a time, and leaving the old request waiting would
+/// strand it.
+pub fn request(kind: Kind, title: &str, extensions: Option<Vec<String>>, suggested: Option<String>) -> Receiver<Vec<PathBuf>> {
+    let (tx, rx) = channel();
+    PENDING.with(|slot| {
+        let mut slot = slot.borrow_mut();
+        if let Some(prev) = slot.take()
+            && let Some(tx) = prev.answer
+        {
+            let _ = tx.send(Vec::new());
+        }
+        *slot = Some(Pending {
+            kind,
+            title: title.to_string(),
+            extensions,
+            dir: PathBuf::new(),
+            name: suggested.unwrap_or_default(),
+            picked: Vec::new(),
+            note: None,
+            started: false,
+            answer: Some(tx),
+        });
+    });
+    rx
+}
+
+/// Whether this window has a dialog waiting to be drawn.
+#[allow(dead_code)]
+pub fn is_open() -> bool {
+    PENDING.with(|slot| slot.borrow().is_some())
+}
+
+/// Close this window's dialog, if any, answering "cancelled" — for a shell that
+/// is quitting while one is open.
+#[allow(dead_code)]
+pub fn cancel() {
+    PENDING.with(|slot| {
+        if let Some(pending) = slot.borrow_mut().take()
+            && let Some(tx) = pending.answer
+        {
+            let _ = tx.send(Vec::new());
+        }
+    });
+}
+
+/// Roots to offer, as (label, path).
+fn roots() -> Vec<(String, PathBuf)> {
+    let mut v = Vec::new();
+    if let Some(d) = EXT_DIR.get() {
+        v.push(("App folder".to_string(), d.clone()));
+        // Sibling of the app's own files, still owned by the app.
+        if let Some(parent) = d.parent() {
+            v.push(("App storage".to_string(), parent.to_path_buf()));
+        }
+    }
+    for (label, sub) in [("Download", "Download"), ("Pictures", "Pictures"), ("DCIM", "DCIM"), ("Documents", "Documents")] {
+        v.push((label.to_string(), Path::new(SHARED_ROOT).join(sub)));
+    }
+    v.push(("Internal storage".to_string(), PathBuf::from(SHARED_ROOT)));
+    v
+}
+
+/// The app's folder in `Android/media`, which *is* reachable over a USB cable (`Android/data` is
+/// not, from Android 11 on): `…/Android/data/<package>/files` → `…/Android/media/<package>`.
+pub fn media_dir() -> Option<PathBuf> {
+    media_dir_from(EXT_DIR.get()?)
+}
+
+/// The derivation, on its own so it can be pinned by a test: `…/Android/data/<package>/files`
+/// → `…/Android/media/<package>`.
+fn media_dir_from(external_files: &Path) -> Option<PathBuf> {
+    let package_dir = external_files.parent()?;
+    let android = package_dir.parent()?.parent()?;
+    Some(android.join("media").join(package_dir.file_name()?))
+}
+
+/// The Fonts folder inside it: the visible folder a font file is dropped into.
+pub fn fonts_dir() -> Option<PathBuf> {
+    Some(media_dir()?.join("Fonts"))
+}
+
+/// Point the font scan at a folder the user can reach over a USB cable.
+///
+/// # Why this is needed on Android and on no other platform
+///
+/// `system_font_dirs()` in this app's font code takes its Linux branch here and scans
+/// `/usr/share/fonts`, `$HOME/.fonts` and `$HOME/.local/share/fonts` — and none of those exist on
+/// Android: the platform's own faces are in `/system/fonts`, and `HOME` is unset. So the app knows
+/// only its bundled families and there is no way to add one — where VectorCraft and PhotoCraft have
+/// `set_platform_font_files`/`set_app_font_dir` hooks, this app's font code has neither. It *does*
+/// read `HOME` at every scan, though, so pointing `HOME` at the app's media folder and putting the
+/// fonts where that branch looks gives the same result with no change to the app: drop a `.ttf`
+/// into `Fonts/` over the cable, reopen the app, and it is in the font list.
+///
+/// The two names the scan looks for are hidden ones (`.fonts`, `.local/share/fonts`), so both are
+/// symlinks to the visible `Fonts` folder — the user drops a file in one place and the app reads it
+/// from the other.
+///
+/// The scan runs once per process (a `OnceLock` in the app), which is why a new font needs the app
+/// reopened rather than a reload.
+#[cfg(target_os = "android")]
+pub fn register_fonts() {
+    let Some(fonts) = fonts_dir() else {
+        log::warn!("fonts: no Fonts folder to register; adding a font will not work");
+        return;
+    };
+    let Some(media) = media_dir() else {
+        return;
+    };
+    if let Err(e) = std::fs::create_dir_all(&fonts) {
+        log::warn!("fonts: could not make {}: {e}", fonts.display());
+        return;
+    }
+    log::info!("fonts: the Fonts folder is {}", fonts.display());
+    // SAFETY: called from `android_main` before eframe starts, so nothing else is reading the
+    // environment yet; the app's font code only ever reads `HOME`.
+    unsafe { std::env::set_var("HOME", &media) };
+    link_fonts_dir(&fonts, &media.join(".fonts"));
+    link_fonts_dir(&fonts, &media.join(".local").join("share").join("fonts"));
+}
+
+/// Make `link` a directory symlink to `target`, replacing a stale one. Failure is logged and
+/// survivable: the folder the user drops fonts into still exists, the app just cannot see it yet.
+#[cfg(target_os = "android")]
+fn link_fonts_dir(target: &Path, link: &Path) {
+    if let Some(parent) = link.parent() {
+        let _ = std::fs::create_dir_all(parent);
+    }
+    if std::fs::read_link(link).is_ok() {
+        let _ = std::fs::remove_file(link);
+    }
+    if !link.exists()
+        && let Err(e) = std::os::unix::fs::symlink(target, link)
+    {
+        log::warn!("fonts: could not link {} → {}: {e}", link.display(), target.display());
+    }
+}
+
+
+/// The best directory to open first: the app folder is always writable, so it
+/// is the only safe default — a desktop path arriving as a suggestion never
+/// exists on the device.
+fn default_dir() -> PathBuf {
+    EXT_DIR.get().cloned().unwrap_or_else(|| PathBuf::from(SHARED_ROOT))
+}
+
+fn readable(dir: &Path) -> bool {
+    std::fs::read_dir(dir).is_ok()
+}
+
+/// Directory entries, folders first, filtered by `extensions` when given.
+fn entries(dir: &Path, extensions: Option<&Vec<String>>) -> Result<(Vec<PathBuf>, Vec<PathBuf>), String> {
+    let rd = std::fs::read_dir(dir).map_err(|e| format!("{}: {e}", dir.display()))?;
+    let (mut dirs, mut files) = (Vec::new(), Vec::new());
+    for entry in rd.flatten() {
+        let path = entry.path();
+        let name = entry.file_name().to_string_lossy().to_string();
+        if name.starts_with('.') {
+            continue;
+        }
+        if path.is_dir() {
+            dirs.push(path);
+        } else if let Some(exts) = extensions {
+            let ext = path.extension().map(|e| e.to_string_lossy().to_ascii_lowercase());
+            if ext.as_ref().is_some_and(|e| exts.iter().any(|w| w.eq_ignore_ascii_case(e))) {
+                files.push(path);
+            }
+        } else {
+            files.push(path);
+        }
+    }
+    dirs.sort_by_key(|p| p.file_name().map(|n| n.to_string_lossy().to_ascii_lowercase()));
+    files.sort_by_key(|p| p.file_name().map(|n| n.to_string_lossy().to_ascii_lowercase()));
+    Ok((dirs, files))
+}
+
+fn file_label(path: &Path) -> String {
+    path.file_name().map(|n| n.to_string_lossy().to_string()).unwrap_or_default()
+}
+
+/// Draw the picker if this window has a dialog queued. Called from the shell's
+/// `ui`, *after* forwarding to the app's own `ui`, so the window floats above
+/// the editor.
+pub fn draw(ctx: &egui::Context) {
+    // Taken out for the duration rather than borrowed, so nothing in here can trip over a
+    // re-entrant borrow; it is put back below while the user has not answered.
+    let Some(mut pending) = PENDING.with(|slot| slot.borrow_mut().take()) else {
+        return;
+    };
+    let kind = pending.kind;
+    // First frame: pick a starting directory.
+    if !pending.started {
+        pending.started = true;
+        pending.dir = default_dir();
+        if kind == Kind::Save && pending.name.is_empty() {
+            pending.name = "untitled".to_string();
+        }
+    }
+
+    let mut answer: Option<Vec<PathBuf>> = None;
+    let mut cancel = false;
+    let mut navigate: Option<PathBuf> = None;
+
+    let dir = pending.dir.clone();
+    let listing = entries(&dir, pending.extensions.as_ref());
+    let multi = kind == Kind::OpenMany;
+    // A tablet screen is smaller than the desktop default, and in portrait
+    // narrower than a hard-coded desktop width. `content_rect` is the area egui
+    // considers safe (it excludes an OS status bar where the backend reports one).
+    let screen = ctx.content_rect();
+    let (w, h) = ((screen.width() * 0.92).min(720.0), (screen.height() * 0.82).min(620.0));
+    let title = pending.title.clone();
+
+    egui::Window::new(title)
+        .collapsible(false)
+        .resizable(true)
+        .default_width(w)
+        .default_height(h)
+        .default_pos(screen.center() - egui::vec2(w, h) / 2.0)
+        .show(ctx, |ui| {
+            // Finger-sized rows: the default spacing is sized for a mouse.
+            ui.spacing_mut().item_spacing = egui::vec2(6.0, 6.0);
+            ui.spacing_mut().button_padding = egui::vec2(10.0, 8.0);
+
+            // Roots
+            ui.horizontal_wrapped(|ui| {
+                for (label, path) in roots() {
+                    let ok = readable(&path);
+                    let here = path == dir;
+                    let text = if ok { label } else { format!("{label} \u{1F512}") };
+                    if ui.add_enabled(ok && !here, egui::Button::new(text)).clicked() {
+                        navigate = Some(path);
+                    }
+                }
+            });
+            ui.separator();
+
+            // Current path + up
+            ui.horizontal_wrapped(|ui| {
+                if ui.button("\u{2B06} Up").clicked()
+                    && let Some(parent) = dir.parent()
+                {
+                    navigate = Some(parent.to_path_buf());
+                }
+                if ui.button("\u{1F4C1} App folder").clicked() {
+                    navigate = Some(default_dir());
+                }
+                ui.label(egui::RichText::new(dir.display().to_string()).monospace().small());
+            });
+
+            if let Some(note) = &pending.note {
+                ui.colored_label(egui::Color32::from_rgb(220, 160, 60), note);
+            }
+
+            ui.separator();
+            let list_h = (h - 190.0).max(120.0);
+            egui::ScrollArea::vertical().max_height(list_h).show(ui, |ui| match &listing {
+                Err(e) => {
+                    ui.label("Cannot read this folder.");
+                    ui.label(egui::RichText::new(e.clone()).monospace().weak().small());
+                    ui.label("Grant \"All files access\" in Settings \u{25B8} Apps \u{25B8} Special access to browse shared storage.");
+                }
+                Ok((dirs, files)) => {
+                    if dirs.is_empty() && files.is_empty() {
+                        ui.label("(empty \u{2014} no matching files)");
+                    }
+                    for d in dirs {
+                        if ui.button(format!("\u{1F4C1} {}", file_label(d))).clicked() {
+                            navigate = Some(d.clone());
+                        }
+                    }
+                    if kind != Kind::Folder {
+                        for f in files {
+                            let chosen = pending.picked.iter().any(|p| p == f);
+                            let mark = if chosen { "\u{2611}" } else { "\u{2610}" };
+                            let label = if multi { format!("{mark} {}", file_label(f)) } else { format!("   {}", file_label(f)) };
+                            if ui.button(label).clicked() {
+                                if kind == Kind::Save {
+                                    pending.name = file_label(f);
+                                } else if multi {
+                                    if chosen {
+                                        pending.picked.retain(|p| p != f);
+                                    } else {
+                                        pending.picked.push(f.clone());
+                                    }
+                                } else {
+                                    answer = Some(vec![f.clone()]);
+                                }
+                            }
+                        }
+                    }
+                }
+            });
+
+            ui.separator();
+            ui.horizontal_wrapped(|ui| match kind {
+                Kind::Save => {
+                    ui.label("File name:");
+                    ui.add(egui::TextEdit::singleline(&mut pending.name).desired_width((w - 260.0).max(160.0)));
+                    if ui.button("Save").clicked() {
+                        let name = pending.name.trim().to_string();
+                        if name.is_empty() {
+                            pending.note = Some("Enter a file name.".to_string());
+                        } else {
+                            answer = Some(vec![dir.join(name)]);
+                        }
+                    }
+                }
+                Kind::Folder => {
+                    if ui.button("Choose this folder").clicked() {
+                        answer = Some(vec![dir.clone()]);
+                    }
+                }
+                Kind::OpenMany => {
+                    let n = pending.picked.len();
+                    let label = if n == 0 { "Place".to_string() } else { format!("Place {n} file(s)") };
+                    if ui.add_enabled(n > 0, egui::Button::new(label)).clicked() {
+                        answer = Some(pending.picked.clone());
+                    }
+                }
+                Kind::Open => {
+                    if ui.button("Open").clicked() {
+                        // A file has to be tapped in the list above for an Open dialog.
+                        pending.note = Some("Tap a file to open it.".to_string());
+                    }
+                }
+            });
+            if ui.button("Cancel").clicked() {
+                cancel = true;
+            }
+
+            if dir == default_dir() {
+                ui.label(egui::RichText::new("Tip: push files here over USB, or grant \"All files access\" to browse the whole tablet.").weak().small());
+            }
+        });
+
+    if let Some(dir) = navigate {
+        pending.dir = dir;
+        pending.note = None;
+    }
+    if answer.is_some() || cancel {
+        // Cancelled: an empty answer is what every seam here reads as one.
+        let paths = answer.unwrap_or_default();
+        if let Some(tx) = pending.answer.take() {
+            let _ = tx.send(paths);
+        }
+    } else {
+        // Still open: it stays this window's dialog. The app only wakes the window about once a
+        // second while it waits, so the picker keeps asking for frames itself.
+        PENDING.with(|slot| *slot.borrow_mut() = Some(pending));
+        ctx.request_repaint();
+    }
+}
diff --git a/apps/gridcraft-android/src/intents.rs b/apps/gridcraft-android/src/intents.rs
new file mode 100644
index 00000000..7729f566
--- /dev/null
+++ b/apps/gridcraft-android/src/intents.rs
@@ -0,0 +1,299 @@
+//! Incoming and outgoing Android intents — the half of "open with / share" that does not need
+//! `startActivityForResult`.
+//!
+//! # The gap
+//!
+//! `android-activity` 0.6.1 does not expose `startActivityForResult`, so the Storage Access
+//! Framework's `ACTION_OPEN_DOCUMENT`/`ACTION_CREATE_DOCUMENT` pickers cannot be driven from
+//! Rust alone (they need an `onActivityResult` override in a Java `Activity` subclass). What
+//! *is* reachable without Java glue is everything that goes through the Activity's *launching*
+//! intent and through fire-and-forget `startActivity` calls:
+//!
+//! - **Incoming `ACTION_VIEW`** — another app hands us a file ("Open with WordCraft"). The URI
+//!   arrives in `getIntent().getData()` at startup; a `content://` URI is copied to a file in
+//!   the app's cache directory and the shell opens that file on its first frame.
+//! - **Incoming `ACTION_SEND`** — another app shares text or an image. `EXTRA_TEXT` is kept for
+//!   the app to import; `EXTRA_STREAM` is copied to the cache directory like a `VIEW` URI.
+//! - **Outgoing `ACTION_SEND`** — "share this document/text" builds a chooser intent and starts
+//!   it with `startActivity`. Text needs no `FileProvider`; a file does, and the manifest has
+//!   none yet, so `share_file` is provided but documented as needing a provider before it works
+//!   on Android 7+.
+//!
+//! Text-only reads are cheap (a handful of JNI calls); copying a `content://` stream reads the
+//! whole file into memory once, which is what the desktop's "open" path does anyway.
+
+use std::cell::RefCell;
+use std::path::{Path, PathBuf};
+
+#[cfg(target_os = "android")]
+use winit::platform::android::activity::AndroidApp;
+
+#[cfg(target_os = "android")]
+thread_local! {
+    static APP: RefCell<Option<AndroidApp>> = const { RefCell::new(None) };
+}
+
+#[derive(Debug)]
+pub enum LaunchIntent {
+    /// Open this file (copied to the cache dir when it came in as a `content://` URI).
+    OpenFile(PathBuf),
+    /// Import this text (a shared note, a snippet from another app).
+    ImportText(String),
+}
+
+/// Remember the Activity the intent calls go through. Called once, before `run_native`.
+#[cfg(target_os = "android")]
+pub fn install(app: &AndroidApp) {
+    APP.with(|slot| *slot.borrow_mut() = Some(app.clone()));
+}
+
+#[cfg(not(target_os = "android"))]
+pub fn install() {}
+
+/// Read the launching intent, if any, and turn it into something the shell can act on.
+///
+/// Returns `None` on the host build, before `install`, when there is no launching intent, or when
+/// the intent is something this app does not handle (a different action, or a URI it cannot read).
+pub fn launch() -> Option<LaunchIntent> {
+    #[cfg(target_os = "android")]
+    {
+        return with_app(read_launch);
+    }
+    #[cfg(not(target_os = "android"))]
+    None
+}
+
+/// Start a text share sheet (no `FileProvider` needed).
+pub fn share_text(text: &str) {
+    #[cfg(target_os = "android")]
+    with_app(|app| write_share_text(app, text));
+}
+
+/// Start a file share sheet. Needs a `FileProvider` entry in the manifest to work on Android 7+;
+/// without one, `startActivity` throws `FileUriExposedException` and the call is logged and
+/// ignored. Provided so the wiring exists; the manifest change is a follow-up.
+pub fn share_file(path: &Path, mime: &str) {
+    #[cfg(target_os = "android")]
+    with_app(|app| write_share_file(app, path, mime));
+}
+
+#[cfg(target_os = "android")]
+fn with_app<T>(call: impl FnOnce(&AndroidApp) -> T) -> T {
+    APP.with(|slot| {
+        let guard = slot.borrow();
+        let app = guard.as_ref().expect("intents::install was not called");
+        call(app)
+    })
+}
+
+// The functions below are only compiled on Android; on other targets `launch`/`share_*` are no-ops
+// or return `None`, so the host tests never touch JNI.
+
+#[cfg(target_os = "android")]
+fn read_launch(app: &AndroidApp) -> Option<LaunchIntent> {
+    use jni::objects::JObject;
+
+    let raw_activity = app.activity_as_ptr() as jni::sys::jobject;
+    let vm = unsafe { jni::JavaVM::from_raw(app.vm_as_ptr().cast()) };
+
+    vm.attach_current_thread(|env| -> jni::errors::Result<Option<LaunchIntent>> {
+        use jni::JValue;
+        let activity = unsafe { JObject::from_raw(env, raw_activity) };
+        let intent = env
+            .call_method(&activity, name(c"getIntent"), method("()Landroid/content/Intent;").unwrap().method_signature(), &[])?
+            .l()?;
+        if intent.is_null() {
+            return Ok(None);
+        }
+        let action = call_string(env, &intent, c"getAction")?;
+        let action = action.as_deref().unwrap_or("");
+
+        // ACTION_SEND: text or a stream.
+        if action == "android.intent.action.SEND" {
+            let extra_text = string_extra(env, &intent, "android.intent.extra.TEXT");
+            if let Some(text) = extra_text.filter(|t| !t.trim().is_empty()) {
+                return Ok(Some(LaunchIntent::ImportText(text)));
+            }
+            // EXTRA_STREAM
+            let key = env.new_string("android.intent.extra.STREAM")?;
+            let value = env
+                .call_method(&intent, name(c"getParcelableExtra"), method("(Ljava/lang/String;)Landroid/os/Parcelable;").unwrap().method_signature(), &[JValue::Object(&key)])?
+                .l()?;
+            if !value.is_null() {
+                let raw_uri = value.into_raw();
+                if let Some(path) = copy_uri(env, &activity, raw_uri, app) {
+                    return Ok(Some(LaunchIntent::OpenFile(path)));
+                }
+            }
+            return Ok(None);
+        }
+
+        // ACTION_VIEW: a file.
+        if action == "android.intent.action.VIEW" {
+            let uri = env
+                .call_method(&intent, name(c"getData"), method("()Landroid/net/Uri;").unwrap().method_signature(), &[])?
+                .l()?;
+            if !uri.is_null() {
+                let raw_uri = uri.into_raw();
+                if let Some(path) = copy_uri(env, &activity, raw_uri, app) {
+                    return Ok(Some(LaunchIntent::OpenFile(path)));
+                }
+            }
+        }
+
+        Ok(None)
+    })
+    .ok()
+    .flatten()
+}
+
+#[cfg(target_os = "android")]
+fn copy_uri(env: &mut jni::Env<'_>, activity: &jni::objects::JObject<'_>, raw_uri: jni::sys::jobject, app: &AndroidApp) -> Option<PathBuf> {
+    use jni::JValue;
+    let uri = unsafe { jni::objects::JObject::from_raw(env, raw_uri) };
+
+    // Resolve a display name for the cached file.
+    let resolver = env
+        .call_method(activity, name(c"getContentResolver"), method("()Landroid/content/ContentResolver;").unwrap().method_signature(), &[])
+        .ok()?
+        .l()
+        .ok()?;
+    if resolver.is_null() {
+        return None;
+    }
+
+    let stream = env
+        .call_method(&resolver, name(c"openInputStream"), method("(Landroid/net/Uri;)Ljava/io/InputStream;").unwrap().method_signature(), &[JValue::Object(&uri)])
+        .ok()?
+        .l()
+        .ok()?;
+    if stream.is_null() {
+        return None;
+    }
+
+    // Read the whole stream.
+    let mut bytes = Vec::new();
+    let buf = env.new_byte_array(64 * 1024).ok()?;
+    loop {
+        let n = env
+            .call_method(&stream, name(c"read"), method("([B)I").unwrap().method_signature(), &[JValue::Object(&buf)])
+            .ok()?
+            .i()
+            .ok()?;
+        if n <= 0 {
+            break;
+        }
+        let mut chunk = vec![0i8; n as usize];
+        env.get_byte_array_region(&buf, 0, &mut chunk);
+        bytes.extend(chunk.iter().map(|&b| b as u8));
+    }
+    let _ = env.call_method(&stream, name(c"close"), method("()V").unwrap().method_signature(), &[]);
+
+    // Cache dir + a name derived from the URI's last path segment.
+    let cache = app.internal_data_path().unwrap_or_else(|| PathBuf::from(".")).join("intent-cache");
+    let _ = std::fs::create_dir_all(&cache);
+    let name = uri_last_segment(env, &uri).unwrap_or_else(|| "shared.bin".to_string());
+    let safe = name.replace(|c: char| !c.is_alphanumeric() && c != '.' && c != '-' && c != '_', "_");
+    let dest = cache.join(if safe.is_empty() { "shared.bin".to_string() } else { safe });
+    std::fs::write(&dest, &bytes).ok()?;
+    Some(dest)
+}
+
+#[cfg(target_os = "android")]
+fn uri_last_segment(env: &mut jni::Env<'_>, uri: &jni::objects::JObject<'_>) -> Option<String> {
+    let last = env
+        .call_method(uri, name(c"getLastPathSegment"), method("()Ljava/lang/String;").unwrap().method_signature(), &[])
+        .ok()?
+        .l()
+        .ok()?;
+    if last.is_null() {
+        return None;
+    }
+    let s: jni::objects::JString<'_> = unsafe { jni::objects::JString::from_raw(env, last.into_raw()) };
+    s.try_to_string(env).ok()
+}
+
+#[cfg(target_os = "android")]
+fn string_extra(env: &mut jni::Env<'_>, intent: &jni::objects::JObject<'_>, key: &str) -> Option<String> {
+    use jni::JValue;
+    let key = env.new_string(key).ok()?;
+    let value = env
+        .call_method(intent, name(c"getStringExtra"), method("(Ljava/lang/String;)Ljava/lang/String;").unwrap().method_signature(), &[JValue::Object(&key)])
+        .ok()?
+        .l()
+        .ok()?;
+    if value.is_null() {
+        return None;
+    }
+    let s: jni::objects::JString<'_> = unsafe { jni::objects::JString::from_raw(env, value.into_raw()) };
+    s.try_to_string(env).ok()
+}
+
+#[cfg(target_os = "android")]
+fn call_string(env: &mut jni::Env<'_>, obj: &jni::objects::JObject<'_>, method_name: &std::ffi::CStr) -> jni::errors::Result<Option<String>> {
+    let value = env
+        .call_method(obj, jni::strings::JNIStr::from_cstr(method_name).unwrap(), method("()Ljava/lang/String;").unwrap().method_signature(), &[])?
+        .l()?;
+    if value.is_null() {
+        return Ok(None);
+    }
+    let s: jni::objects::JString<'_> = unsafe { jni::objects::JString::from_raw(env, value.into_raw()) };
+    Ok(Some(s.try_to_string(env)?))
+}
+
+
+#[cfg(target_os = "android")]
+fn write_share_text(app: &AndroidApp, text: &str) {
+    use jni::JValue;
+    let raw_activity = app.activity_as_ptr() as jni::sys::jobject;
+    let vm = unsafe { jni::JavaVM::from_raw(app.vm_as_ptr().cast()) };
+    let _ = vm.attach_current_thread(|env| -> jni::errors::Result<()> {
+        let activity = unsafe { jni::objects::JObject::from_raw(env, raw_activity) };
+        let action_send = env.new_string("android.intent.action.SEND")?;
+        let text_plain = env.new_string("text/plain")?;
+        let chooser_title = env.new_string("Share")?;
+        let intent = env.new_object(class(c"android/content/Intent"), method("()V").ok().unwrap().method_signature(), &[])?;
+        let _ = env.call_method(&intent, name(c"setAction"), method("(Ljava/lang/String;)Landroid/content/Intent;").ok().unwrap().method_signature(), &[JValue::Object(&action_send)])?;
+        let _ = env.call_method(&intent, name(c"setType"), method("(Ljava/lang/String;)Landroid/content/Intent;").ok().unwrap().method_signature(), &[JValue::Object(&text_plain)])?;
+        let key = env.new_string("android.intent.extra.TEXT")?;
+        let body = env.new_string(text)?;
+        let _ = env.call_method(&intent, name(c"putExtra"), method("(Ljava/lang/String;Ljava/lang/String;)Landroid/content/Intent;").ok().unwrap().method_signature(), &[JValue::Object(&key), JValue::Object(&body)])?;
+        let chooser = env.call_static_method(class(c"android/content/Intent"), name(c"createChooser"), method("(Landroid/content/Intent;Ljava/lang/CharSequence;)Landroid/content/Intent;").ok().unwrap().method_signature(), &[JValue::Object(&intent), JValue::Object(&chooser_title)])?.l()?;
+        env.call_method(&activity, name(c"startActivity"), method("(Landroid/content/Intent;)V").ok().unwrap().method_signature(), &[JValue::Object(&chooser)])?;
+        Ok(())
+    });
+}
+
+#[cfg(target_os = "android")]
+fn write_share_file(app: &AndroidApp, path: &Path, mime: &str) {
+    // File sharing needs a FileProvider URI on Android 7+. Without a provider entry in the
+    // manifest this throws FileUriExposedException; log and skip rather than crash.
+    log::warn!("intents::share_file({}) not implemented: needs a FileProvider in the manifest", path.display());
+    let _ = (app, mime);
+}
+
+#[cfg(target_os = "android")]
+fn class(name: &'static std::ffi::CStr) -> &'static jni::strings::JNIStr {
+    jni::strings::JNIStr::from_cstr(name).expect("literal class name")
+}
+
+#[cfg(target_os = "android")]
+fn name(name: &'static std::ffi::CStr) -> &'static jni::strings::JNIStr {
+    jni::strings::JNIStr::from_cstr(name).expect("literal member name")
+}
+
+#[cfg(target_os = "android")]
+fn method(signature: &str) -> jni::errors::Result<jni::signature::RuntimeMethodSignature> {
+    jni::signature::RuntimeMethodSignature::from_str(signature)
+}
+
+#[cfg(test)]
+mod tests {
+    // Host-side: nothing JNI-related runs; just make sure the enum is constructible.
+    use super::LaunchIntent;
+    #[test]
+    fn launch_intent_variants_exist() {
+        let _ = LaunchIntent::OpenFile(std::path::PathBuf::from("/tmp/x"));
+        let _ = LaunchIntent::ImportText("hi".to_string());
+    }
+}
diff --git a/apps/gridcraft-android/src/lib.rs b/apps/gridcraft-android/src/lib.rs
new file mode 100644
index 00000000..4ab20c86
--- /dev/null
+++ b/apps/gridcraft-android/src/lib.rs
@@ -0,0 +1,513 @@
+//! GridCraft on Android (arm64-v8a): the real engine and egui shell, running on winit's
+//! NativeActivity backend.
+//!
+//! # What this crate is
+//!
+//! A shell around the *unmodified* GridCraft crates — `gridcraft-engine` (the workbook model,
+//! the formula engine, XLSX) and `gridcraft-ui-egui` (the ribbon, Backstage, grid, dialogs).
+//! Nothing in those crates is patched. This crate supplies only what `apps/gridcraft` would
+//! normally supply: the [`Services`] implementation, the preferences files, the window options
+//! and the entry point. The same shape the PhotoCraft, VectorCraft and WordCraft ports used.
+//!
+//! # Why a separate crate, and not a feature on `apps/gridcraft`
+//!
+//! That crate cannot build for Android as written: it carries native dialogs (`rfd`), the OS
+//! clipboard (`arboard`), a control server and a desktop appearance watcher. Verified with
+//! `cargo check -p gridcraft --target aarch64-linux-android`: `arboard` stops first, with
+//! `cannot find Set in module platform` — it has no Android backend at all — and `rfd` fails the
+//! same way with `the trait bound FileDialog: FilePickerDialogImpl is not satisfied`.
+//!
+//! `gridcraft_ui_egui::Services` is a plain struct of `Option<Box<dyn Fn…>>` fields that derives
+//! `Default`, so the fix is not to patch the app but to build a platform that supplies what it
+//! can and omits the rest. Its `ui-egui` is Android-clean: `cargo check -p gridcraft-ui-egui
+//! --target aarch64-linux-android` passes with no changes.
+//!
+//! # Which half of the seam this shell fills, and why it is not `pick_open`/`pick_save`
+//!
+//! GridCraft's dialogs come in two shapes. `pick_open` and `pick_save` are the *blocking* ones —
+//! on the desktop they run `rfd` in line and return the chosen path immediately. That cannot
+//! work here: a picker this shell has to *draw* needs the frame to end and come back, so a
+//! function that must return a path now can never show one. Leaving both `None` is what makes
+//! the app take its other branch, the one it already has for hosts that cannot block — the
+//! browser build's:
+//!
+//! - **Open / Insert Picture** — `open_async` and `pick_picture_async` start the pick, and the
+//!   file arrives later through `Services::inbox` as `(name, bytes)`, exactly as a browser
+//!   file input delivers it. The app opens or inserts it on the next frame.
+//! - **Save As / Export** — `download(name, bytes)` is handed the finished file, exactly as the
+//!   browser is. Here it asks for a path first and writes there.
+//!
+//! So every dialog is reachable, and the only visible difference from the desktop is that Save
+//! asks for the folder (the app is not the one holding a path afterwards — see "Gaps").
+//!
+//! # Feature notes
+//!
+//! - `android-native-activity` **must** be on. Without a backend feature, `android-activity` is
+//!   pulled with no backend and the build fails with `file not found for module activity_impl`
+//!   plus `Either "game-activity" or "native-activity" must be enabled as features`.
+//! - `accesskit` **must** be off, and here it is unreachable: `ui-egui` has no eframe dependency
+//!   at all, so this crate is the only eframe user in the graph and never asks for it.
+//! - `NativeOptions::android_app` must be `Some(..)`: eframe hands it to
+//!   `EventLoopBuilderExtAndroid::with_android_app` and returns an error without it.
+//!
+//! # What Android cannot do yet
+//!
+//! Honest gaps, not oversights:
+//!
+//! - **A saved workbook does not learn its own path.** The desktop's `pick_save` hands the path
+//!   back to the app, which records it, so the next Ctrl+S writes silently to the same file.
+//!   This shell is given the bytes instead (that is the seam), so the write happens here and the
+//!   session keeps `path = None`: the title bar stays "Book1" and the next Save asks again. The
+//!   bytes written are the document's, so nothing is lost — it is the remembering that is
+//!   missing. Anything else would have to guess which document was active when the user
+//!   answered, and saving the wrong workbook over a file is worse than asking twice.
+//! - **No system clipboard.** `arboard` has no Android backend, so `copy_html` and `paste_html`
+//!   stay `None`: Cut/Copy/Paste of cells falls back to whatever egui itself can do, and the
+//!   HTML flavour that keeps pasted numbers numeric is gone with it.
+//! - **No opening links.** `open_url` stays `None`, so the Discord/website/GitHub links in the
+//!   credits and the Backstage do nothing — that needs an `Intent` through JNI.
+//! - **No printing.** `print` stays `None`; File ▸ Print reports what GridCraft's own fallback
+//!   says rather than handing a PDF to a print service.
+//! - **No stylus pressure or tilt.** A pen degrades to ordinary touch.
+//! - **No system title bar.** The app draws its own, which is what the tablet shows, fullscreen.
+//!
+//! The workbook model, the formula engine, the grid and the XLSX writer are platform-neutral and
+//! unaffected, and the interface fonts are embedded, so text works with no system font folder.
+
+use std::path::{Path, PathBuf};
+use std::sync::mpsc::Receiver;
+use std::sync::{Arc, Mutex, OnceLock};
+use std::time::Duration;
+
+use gridcraft_engine::Session;
+use gridcraft_ui_egui::{Inbox, Services, SheetApp, UiState};
+
+mod clipboard;
+mod file_picker;
+mod intents;
+mod modifiers;
+mod prefs_watch;
+mod touch_scroll;
+
+/// The app's private data directory, captured in `android_main` before any service closure runs:
+/// `<internal storage>/Android/data/ai.storyteller.gridcraft/files`.
+///
+/// `internal_data_path()` needs no runtime permission — it is the app's own sandbox — which is
+/// why the preferences and the log land here rather than in shared storage.
+static DATA_DIR: OnceLock<PathBuf> = OnceLock::new();
+
+/// Messages the shell shows the user when work it started on a worker thread fails.
+///
+/// Reading a picked file and writing a Save happen off the frame, where nothing can raise a
+/// dialog; without this a failed write to a folder the app may not touch would look like the
+/// Save button doing nothing.
+type Notices = Arc<Mutex<Vec<String>>>;
+
+/// Mirrors the desktop `load_prefs`, with the settings directory replaced by the app's own.
+fn load_prefs(app: &mut SheetApp) {
+    let Some(dir) = DATA_DIR.get() else {
+        return;
+    };
+    // First run: follow the device's language and appearance until the user chooses and saves.
+    app.ui.language = gridcraft_ui_egui::i18n::Language::system();
+    app.ui.system_theme = true;
+    if let Ok(bytes) = std::fs::read(dir.join("ui.json"))
+        && let Ok(ui) = serde_json::from_slice::<UiState>(&bytes)
+    {
+        let saved = serde_json::from_slice(&bytes).ok().and_then(|v| gridcraft_ui_egui::i18n::saved_language(&v));
+        let language = saved.unwrap_or(app.ui.language);
+        app.ui = ui;
+        app.ui.language = language;
+    }
+    if let Ok(bytes) = std::fs::read(dir.join("prefs.json"))
+        && let Ok(prefs) = serde_json::from_slice(&bytes)
+    {
+        app.session.prefs = prefs;
+    }
+}
+
+/// How often the preferences are looked at; a change is written at the next look. Short enough
+/// that nothing a user would miss is stale, long enough to cost nothing while the app is idle.
+const PREFS_EVERY: Duration = Duration::from_secs(2);
+
+/// What goes to `ui.json` — where the recent-documents list lives.
+fn prefs_ui_bytes(app: &SheetApp) -> Vec<u8> {
+    serde_json::to_vec_pretty(&app.ui).unwrap_or_default()
+}
+
+/// What goes to `prefs.json` — the engine's own preferences.
+fn prefs_engine_bytes(app: &SheetApp) -> Vec<u8> {
+    serde_json::to_vec_pretty(&app.session.prefs).unwrap_or_default()
+}
+
+/// The two files the desktop writes on its way out, in the app's own folder, which always exists.
+fn prefs_files() -> (Option<PathBuf>, Option<PathBuf>) {
+    let Some(dir) = DATA_DIR.get() else {
+        return (None, None);
+    };
+    let _ = std::fs::create_dir_all(dir);
+    (Some(dir.join("ui.json")), Some(dir.join("prefs.json")))
+}
+
+/// Write the preferences if they changed, at most every [`PREFS_EVERY`] (see [`prefs_watch`]).
+fn save_prefs_if_due(app: &SheetApp, ui: &mut prefs_watch::Writer, engine: &mut prefs_watch::Writer) {
+    if ui.due() {
+        let bytes = prefs_ui_bytes(app);
+        ui.store(&bytes);
+    }
+    if engine.due() {
+        let bytes = prefs_engine_bytes(app);
+        engine.store(&bytes);
+    }
+}
+
+
+/// The workbooks Open offers, as on the desktop.
+fn workbook_extensions() -> Option<Vec<String>> {
+    file_picker::extensions(&[&["xlsx", "xlsm", "xls", "xlsb", "ods", "csv", "tsv", "txt", "json"]])
+}
+
+fn picture_extensions() -> Option<Vec<String>> {
+    file_picker::extensions(&[&["png", "jpg", "jpeg"]])
+}
+
+/// Wait for a pick off the UI thread, read what it names and hand it to the app the way a
+/// browser file input does: `(name, bytes)` pushed into the inbox the app polls each frame.
+///
+/// The desktop's `pick_open` returns a path instead, and `open_async` exists precisely for hosts
+/// that cannot — on the web the bytes come from a `File` handle, here from the filesystem.
+fn deliver(inbox: Inbox, ctx: egui::Context, picks: Receiver<Vec<PathBuf>>, notices: Notices) {
+    let reading = std::thread::Builder::new().name("file read".into()).spawn(move || {
+        let Ok(paths) = picks.recv() else {
+            return;
+        };
+        let mut arrived = false;
+        for path in paths {
+            match std::fs::read(&path) {
+                Ok(bytes) => {
+                    let name = path.file_name().map(|n| n.to_string_lossy().into_owned()).unwrap_or_default();
+                    log::info!("read {} ({} bytes)", path.display(), bytes.len());
+                    inbox.lock().unwrap_or_else(std::sync::PoisonError::into_inner).push((name, bytes));
+                    arrived = true;
+                }
+                Err(e) => {
+                    log::error!("couldn't read {}: {e}", path.display());
+                    notices.lock().unwrap_or_else(std::sync::PoisonError::into_inner).push(format!("Couldn't read {}: {e}", path.display()));
+                }
+            }
+        }
+        // The app is idle while it waits; wake it to use what arrived.
+        if arrived {
+            ctx.request_repaint();
+        }
+    });
+    if let Err(e) = reading {
+        log::error!("couldn't start the file-reading thread: {e}");
+    }
+}
+
+/// Write the bytes the app handed to `download`, once the user has named a folder and file.
+///
+/// This is GridCraft's browser save path landing on a real filesystem: it asks where, then
+/// writes there. The app's own folder (what Save suggests first) always works with no
+/// permission at all; anywhere else under shared storage needs "All files access".
+fn save(ctx: egui::Context, picks: Receiver<Vec<PathBuf>>, bytes: Vec<u8>, notices: Notices) {
+    let writing = std::thread::Builder::new().name("file write".into()).spawn(move || {
+        let Ok(paths) = picks.recv() else {
+            return;
+        };
+        let Some(path) = paths.into_iter().next() else {
+            return;
+        };
+        match std::fs::write(&path, &bytes) {
+            Ok(()) => log::info!("wrote {} ({} bytes)", path.display(), bytes.len()),
+            Err(e) => {
+                log::error!("couldn't write {}: {e}", path.display());
+                notices.lock().unwrap_or_else(std::sync::PoisonError::into_inner).push(format!("Couldn't write {}: {e}", path.display()));
+            }
+        }
+        ctx.request_repaint();
+    });
+    if let Err(e) = writing {
+        log::error!("couldn't start the file-writing thread: {e}");
+    }
+}
+
+/// The Android `Services`: the asynchronous half of the desktop's, plus the picker.
+///
+/// Everything the desktop fills with a blocking dialog or a system integration stays `None`,
+/// and that is deliberate on every field — see the module docs.
+fn android_services(ctx: egui::Context, notices: Notices) -> Services {
+    let inbox: Inbox = Inbox::default();
+
+    let open_inbox = inbox.clone();
+    let open_ctx = ctx.clone();
+    let open_notices = notices.clone();
+    let picture_ctx = ctx.clone();
+    let picture_notices = notices.clone();
+    let save_ctx = ctx.clone();
+    let save_notices = notices.clone();
+
+    Services {
+        // File ▸ Save As: a save dialog that answers between frames, so the workbook records the
+        // file the user chose. Handing the app's own `download` its bytes instead (below) writes
+        // the file and tells the app nothing, which is why the title stayed "Book1" and closing
+        // asked to save what had just been saved.
+        pick_save_async: Some(Box::new(move |suggested: &str| {
+            let picks = file_picker::request(file_picker::Kind::Save, "Save As \u{2014} Android", None, Some(suggested.to_string()));
+            path_answer(picks)
+        })),
+        // File ▸ Open: the picked workbook arrives through the inbox.
+        open_async: Some(Box::new(move || {
+            let picks = file_picker::request(file_picker::Kind::Open, "Open \u{2014} Android", workbook_extensions(), None);
+            deliver(open_inbox.clone(), open_ctx.clone(), picks, open_notices.clone());
+        })),
+        // Insert ▸ Pictures: its own inbox, so a cancelled pick cannot land in a later dialog.
+        pick_picture_async: Some(Box::new(move |inbox: Inbox| {
+            let picks = file_picker::request(file_picker::Kind::Open, "Insert Picture \u{2014} Android", picture_extensions(), None);
+            deliver(inbox, picture_ctx.clone(), picks, picture_notices.clone());
+        })),
+        // File ▸ Save As, and every Backstage export: ask where, then write the bytes there.
+        download: Some(Box::new(move |name: &str, bytes: &[u8]| {
+            let picks = file_picker::request(file_picker::Kind::Save, "Save As \u{2014} Android", None, Some(name.to_string()));
+            save(save_ctx.clone(), picks, bytes.to_vec(), save_notices.clone());
+        })),
+        inbox: Some(inbox),
+        // The ribbon and menu Paste read the clipboard through this; the keyboard shortcut
+        // arrives as `Event::Paste` instead (see `clipboard`).
+        paste_text: Some(Box::new(clipboard::text)),
+        ..Default::default()
+    }
+}
+
+
+/// The picker answers with paths; a save seam speaks of one path, or nothing.
+///
+/// One short-lived thread per dialog, which is the shape the desktop shell has too: it waits for
+/// `rfd`'s future off the UI thread while the frame carries on, and this waits for the picker's
+/// answer the same way. A path-less answer is a cancellation, which is what the app reads it as.
+fn path_answer(picks: Receiver<Vec<PathBuf>>) -> Receiver<Option<String>> {
+    let (answer, rx) = std::sync::mpsc::channel();
+    let waiting = std::thread::Builder::new().name("save dialog".into()).spawn(move || {
+        let path = picks.recv().ok().and_then(|paths| paths.into_iter().next()).map(|p| p.to_string_lossy().into_owned());
+        let _ = answer.send(path);
+    });
+    if let Err(e) = waiting {
+        // The dropped sender reads as cancelled, which is the honest outcome.
+        log::error!("couldn't start the save-dialog thread: {e}");
+    }
+    rx
+}
+
+/// A minimal file logger, so a sideloaded APK leaves a readable trace.
+///
+/// `logcat` is only reachable over adb; a file in the app's own data directory can be pulled with
+/// any file manager, which is what a sideloaded build needs.
+struct FileLogger {
+    sink: Mutex<Option<std::fs::File>>,
+}
+
+impl log::Log for FileLogger {
+    fn enabled(&self, _: &log::Metadata) -> bool {
+        true
+    }
+    fn log(&self, record: &log::Record) {
+        if let Ok(mut guard) = self.sink.lock() {
+            if let Some(f) = guard.as_mut() {
+                use std::io::Write;
+                let _ = writeln!(f, "[{}] {} {}", record.level(), record.target(), record.args());
+            }
+        }
+    }
+    fn flush(&self) {}
+}
+
+static LOGGER: OnceLock<FileLogger> = OnceLock::new();
+
+fn init_logging(dir: &Path) {
+    let Ok(file) = std::fs::OpenOptions::new().create(true).append(true).open(dir.join("gridcraft.log")) else {
+        return;
+    };
+    let logger = LOGGER.get_or_init(|| FileLogger { sink: Mutex::new(None) });
+    if let Ok(mut guard) = logger.sink.lock() {
+        *guard = Some(file);
+    }
+    if log::set_logger(logger).is_ok() {
+        log::set_max_level(log::LevelFilter::Info);
+    }
+}
+
+/// The Android entry point.
+///
+/// `android-activity` spawns a dedicated thread for this and calls it with the activity handle.
+/// `#[unsafe(no_mangle)]` with the Rust ABI is the required shape (edition 2024 requires the
+/// `unsafe(..)` wrapper around `no_mangle`), and it is the symbol the injected NativeActivity
+/// looks for.
+#[cfg(target_os = "android")]
+#[unsafe(no_mangle)]
+pub fn android_main(app: winit::platform::android::activity::AndroidApp) {
+    // Count this window while its loop runs (see `prefs_watch`).
+    let _window = prefs_watch::counted_window();
+    let data_dir = app.internal_data_path().unwrap_or_else(|| PathBuf::from("."));
+    let _ = std::fs::create_dir_all(&data_dir);
+    let _ = DATA_DIR.set(data_dir.clone());
+    // The system clipboard goes through the same Activity handle as the rest of the
+    // platform (see `clipboard`).
+    clipboard::install(&app);
+    intents::install(&app);
+    init_logging(&data_dir);
+    log::info!("GridCraft {} starting on Android; data dir {}", env!("CARGO_PKG_VERSION"), data_dir.display());
+    // The app's external files directory: always readable and writable with no permission, so the
+    // picker offers it as a root and Save suggests it first (see `file_picker`).
+    if let Some(ext) = app.external_data_path() {
+        let _ = std::fs::create_dir_all(&ext);
+        let _ = file_picker::EXT_DIR.set(ext);
+    }
+    // Fonts: a folder the user can drop a font file into over USB, pointed at where this app's font
+    // scan looks (see `file_picker::register_fonts`).
+    file_picker::register_fonts();
+
+    let options = eframe::NativeOptions {
+        viewport: egui::ViewportBuilder::default().with_title("GridCraft").with_app_id("ai.storyteller.gridcraft"),
+        // Required on Android: eframe hands this to
+        // `EventLoopBuilderExtAndroid::with_android_app` and errors without it.
+        android_app: Some(app),
+        ..Default::default()
+    };
+
+    let result = eframe::run_native(
+        "GridCraft",
+        options,
+        Box::new(|cc| {
+            let notices: Notices = Notices::default();
+            let mut app = SheetApp::new(Session::new(), android_services(cc.egui_ctx.clone(), notices.clone()));
+            load_prefs(&mut app);
+            if let Some(rs) = &cc.wgpu_render_state {
+                let info = rs.adapter.get_info();
+                log::info!("wgpu adapter: {info:?}");
+            } else {
+                log::warn!("no wgpu render state");
+            }
+            let (ui_path, engine_path) = prefs_files();
+            Ok(Box::new(Shell {
+                inner: app,
+                notices,
+                modifiers: modifiers::Tracked::default(),
+                touch: touch_scroll::TouchScroll::default(),
+                prefs_ui: prefs_watch::Writer::new(ui_path, PREFS_EVERY),
+                prefs_engine: prefs_watch::Writer::new(engine_path, PREFS_EVERY),
+                pending_launch: intents::launch(),
+            }))
+        }),
+    );
+
+    match result {
+        Ok(()) => log::info!("GridCraft exited normally"),
+        Err(e) => log::error!("GridCraft stopped: {e}"),
+    }
+}
+
+/// Wraps the real app so the platform can act on the frame around it: the picker, and the reports
+/// of work that failed off the frame.
+///
+/// The same shape as the desktop shell (`apps/gridcraft/src/main.rs`) and the web build:
+/// `SheetApp` stays untouched and the platform-specific layer hangs off the outside. Every method
+/// is forwarded, so the app sees no difference.
+struct Shell {
+    inner: SheetApp,
+    notices: Notices,
+    /// Modifier keys, tracked here because the platform never reports them: winit's Android
+    /// backend sends no `ModifiersChanged` at all, which is why Shift+click and every Ctrl
+    /// shortcut are dead without this (see `modifiers`).
+    modifiers: modifiers::Tracked,
+    /// Two-finger scrolling, translated from touches into wheel events (see [`touch_scroll`]).
+    touch: touch_scroll::TouchScroll,
+    /// The preferences, written as the app runs rather than only on the way out: Android never
+    /// gives that ending, so a swipe from Recents would otherwise take every preference with it
+    /// (see [`prefs_watch`]). One writer per file, because they are two files.
+    prefs_ui: prefs_watch::Writer,
+    prefs_engine: prefs_watch::Writer,
+    pending_launch: Option<intents::LaunchIntent>,
+}
+
+impl Shell {
+    /// Anything the picker's threads could not do, said out loud. Taking them one at a time means
+    /// a repeated failure cannot pile up an unbounded list.
+    fn show_notices(&mut self, ctx: &egui::Context) {
+        let mut pending = self.notices.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        let Some(text) = pending.pop() else {
+            return;
+        };
+        if !pending.is_empty() {
+            pending.truncate(1);
+        }
+        drop(pending);
+        egui::Window::new("GridCraft").collapsible(false).resizable(false).anchor(egui::Align2::CENTER_CENTER, egui::vec2(0.0, 0.0)).show(ctx, |ui| {
+            ui.spacing_mut().button_padding = egui::vec2(10.0, 8.0);
+            ui.label(text);
+            if ui.button("OK").clicked() {
+                *self.notices.lock().unwrap_or_else(std::sync::PoisonError::into_inner) = Vec::new();
+            }
+        });
+    }
+}
+
+impl eframe::App for Shell {
+    fn logic(&mut self, ctx: &egui::Context, _frame: &mut eframe::Frame) {
+        if let Some(launch) = self.pending_launch.take() {
+            match launch {
+                intents::LaunchIntent::OpenFile(path) => { self.inner.open_path(path.to_string_lossy().as_ref()); }
+                intents::LaunchIntent::ImportText(text) => {
+                    let path = std::env::temp_dir().join("shared.txt");
+                    if std::fs::write(&path, text).is_ok() { self.inner.open_path(path.to_string_lossy().as_ref()); }
+                }
+            }
+        }
+        self.inner.logic(ctx);
+        save_prefs_if_due(&self.inner, &mut self.prefs_ui, &mut self.prefs_engine);
+    }
+
+    fn raw_input_hook(&mut self, ctx: &egui::Context, raw: &mut egui::RawInput) {
+        for event in &mut raw.events {
+            if let egui::Event::Key { key, .. } = event
+                && *key == egui::Key::BrowserBack
+            {
+                *key = egui::Key::Escape;
+            }
+        }
+        // Before the app, so the frame it sees already has the modifiers a desktop backend would
+        // have reported (see `modifiers`).
+        let modifiers = self.modifiers.apply(raw);
+        // Then the touches: winit's Android backend has no mouse and so sends no wheel events at
+        // all, which is why nothing scrolled. A two-finger drag becomes one here (see
+        // `touch_scroll`).
+        self.touch.apply(raw, modifiers);
+        let lost_focus = raw.viewports.values().any(|v| v.focused == Some(false));
+        if lost_focus {
+            let (ui_bytes, engine_bytes) = (prefs_ui_bytes(&self.inner), prefs_engine_bytes(&self.inner));
+            self.prefs_ui.store_now(&ui_bytes);
+            self.prefs_engine.store_now(&engine_bytes);
+        }
+        // Then the clipboard keys: egui-winit could not turn them into Copy/Cut/Paste
+        // because the backend never reports Modifiers, so they are still ordinary key
+        // presses here (see `clipboard::shortcuts`).
+        clipboard::shortcuts(raw);
+        self.inner.raw_input_hook(ctx, raw);
+    }
+
+    fn ui(&mut self, ui: &mut egui::Ui, _frame: &mut eframe::Frame) {
+        self.inner.ui(ui);
+        // After the app, so the picker and the report float above the grid.
+        file_picker::draw(ui.ctx());
+        // After the app: this is the one place that sees egui's CopyText before egui-winit
+        // consumes it, and puts it on the system clipboard (see `clipboard::publish`).
+        clipboard::publish(ui.ctx());
+        self.show_notices(ui.ctx());
+    }
+
+    fn on_exit(&mut self) {
+        let (ui_bytes, engine_bytes) = (prefs_ui_bytes(&self.inner), prefs_engine_bytes(&self.inner));
+        self.prefs_ui.store_now(&ui_bytes);
+        self.prefs_engine.store_now(&engine_bytes);
+    }
+}
